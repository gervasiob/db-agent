APP_ENV=development
APP_NAME=DB-Agent-TP-Austral
APP_VERSION=0.1.0
DEBUG=true

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=4000

METADATA_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/db_agent_metadata
METADATA_DB_SCHEMA=public

DATABASE_SAMPLE_ROWS=5
MAX_QUERY_ROWS=500
QUERY_TIMEOUT_SECONDS=15
SQL_RETRY_COUNT=2
SCHEMA_RETRIEVAL_TOP_K=8
LLM_INCLUDE_SAMPLE_DATA=true
LLM_SANITIZE_SAMPLE_DATA=true

LOG_LEVEL=INFO
LOG_FORMAT=json

# === Ejemplo conexión target SQL Server (se configura via UI Conexión o POST /database/test-connection, NO aquí) ===
# Requiere ODBC Driver 18 for SQL Server instalado (winget/apt/brew). Ver README sección "SQL Server Support".
# JSON de ejemplo para body de /database/test-connection o campos UI Conexión:
# {
#   "database_type": "sqlserver",
#   "host": "sqlsrv01.corp.local",
#   "port": 1433,
#   "database_name": "erp",
#   "schema": "dbo",
#   "ssl_mode": "disable",
#   // SQL Authentication:
#   "username": "sa",
#   "password": "Str0ngP@ss!"
#   // — o Integrated Auth SSPI / AD (dejar username y password VACÍOS):
#   // "username": "",
#   // "password": ""
# }
